# Local Docker Compose only. Copy to .env in the repository root.
# These sample values are public development defaults, not production credentials.
HMDP_MYSQL_PASSWORD=hmdp_local_only
HMDP_WEB_PORT=8080
HMDP_API_PORT=8081
HMDP_EXPERIENCE_ENABLED=true
HMDP_ADMIN_IDS=
HMDP_PAYMENT_MOCK_ENABLED=false
HMDP_MONITOR_TOKEN=hmdp_dev_metrics
